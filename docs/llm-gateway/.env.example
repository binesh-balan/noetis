# Copy to .env (never commit .env). In Azure, keep these in Key Vault instead.

# Entra ID: your tenant and the "Noetis LLM Gateway" app registration
ENTRA_TENANT_ID=<directory (tenant) id>
ENTRA_API_AUDIENCE=<gateway application (client) id>,api://<gateway application (client) id>
ENTRA_REQUIRED_ROLE=Noetis.User

# Per-user rate limits (budgets are set by sync-users.ps1)
USER_TPM_LIMIT=20000
USER_RPM_LIMIT=30
ALLOWED_MODELS=noetis-deepseek

# Azure AI Foundry (server-side only)
AZURE_AI_API_BASE=https://<resource>.services.ai.azure.com/models
AZURE_AI_API_KEY=<foundry key>

# LiteLLM admin key (starts with sk-) and database password
LITELLM_MASTER_KEY=sk-<long random string>
POSTGRES_PASSWORD=<long random string>
